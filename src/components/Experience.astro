---
const roles = [
  {
    company: 'Nricher',
    title: 'Data Engineer',
    period: 'Sep 2022 — Present',
    location: 'Paris, France',
    points: [
      'Design and maintain large-scale ingestion pipelines processing product catalogs from 20+ e-commerce sources across 8+ major French retailers (Castorama, Fnac, Carrefour, La Redoute, and others)',
      'Built distributed PySpark processing for high-volume product data: parsing semi-structured feeds, cleaning, normalization, deduplication, and multi-source joins',
      'Developed and maintain dbt models in Snowflake for transformation, validation, and modeling of product data post-ingestion',
      'Designed and optimized the Snowflake warehouse architecture — stored procedures, external stages, and table structures for multi-client analytical workloads',
      'Own end-to-end orchestration with Apache Airflow, from ingestion through PySpark processing, Snowflake loading, and dbt transformations',
      'Deliver enriched data via Mirakl for automated listing generation and manage 8+ isolated production environments',
    ],
  },
  {
    company: 'Cognizant',
    title: 'Data Analyst',
    period: 'Aug 2019 — Jul 2021',
    location: 'Hyderabad, India',
    points: [
      'Built SQL and Python (Pandas) workflows to process and analyze large data volumes, feeding Power BI dashboards and automating business reporting',
      'Designed and tracked operational KPIs in Power BI, giving business and project teams visibility into key performance trends',
      'Optimized SQL queries and automated processing to improve analysis performance and reliability',
    ],
  },
  {
    company: 'Tech Mahindra',
    title: 'Data Analyst',
    period: 'Apr 2018 — May 2019',
    location: 'Hyderabad, India',
    points: [
      'Automated data extraction, validation, and reporting pipelines in SQL and Python, feeding Power BI dashboards',
      'Performed quality control and validation before integrating data into reporting tools',
    ],
  },
];
---

<section id="experience">
  <div class="container">
    <span class="eyebrow">Career</span>
    <h2>Experience</h2>

    <div class="timeline">
      {roles.map((role) => (
        <div class="role">
          <div class="role-marker" aria-hidden="true"></div>
          <div class="role-content card">
            <div class="role-head">
              <div>
                <h3>{role.title}</h3>
                <p class="company mono">{role.company} · {role.location}</p>
              </div>
              <span class="period mono">{role.period}</span>
            </div>
            <ul>
              {role.points.map((point) => <li>{point}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin-top: 16px;
    margin-bottom: 48px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 28px;
    position: relative;
    padding-left: 24px;
    border-left: 1px solid var(--border);
  }

  .role {
    position: relative;
  }

  .role-marker {
    position: absolute;
    left: -29px;
    top: 28px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--bg), 0 0 10px var(--accent-glow);
  }

  .role-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
  }

  .role-content h3 {
    font-size: 1.1rem;
  }

  .company {
    color: var(--accent);
    font-size: 0.82rem;
    margin-top: 4px;
  }

  .period {
    font-size: 0.78rem;
    color: var(--text-faint);
    white-space: nowrap;
    padding-top: 4px;
  }

  ul {
    margin: 18px 0 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  li {
    font-size: 0.92rem;
    color: var(--text-dim);
  }
</style>
