---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = new Set(posts.flatMap((post) => post.data.tags));

  return [...tags].map((tag) => {
    const filtered = posts
      .filter((post) => post.data.tags.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return { params: { tag }, props: { tag, posts: filtered } };
  });
}

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`#${tag} — Blog — Utsav Pandey`}
  description={`Posts tagged "${tag}" — data engineering notes on ${tag}.`}
>
  <section>
    <div class="container">
      <a href="/blog" class="back mono">&larr; All posts</a>
      <span class="eyebrow">Tag</span>
      <h1>#{tag}</h1>
      <p class="sub">{posts.length} post{posts.length === 1 ? '' : 's'} tagged &ldquo;{tag}&rdquo;.</p>

      <div class="posts">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="card post">
            <div class="post-head">
              <h2>{post.data.title}</h2>
              <time class="mono">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>
            <p>{post.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .back {
    display: block;
    font-size: 0.82rem;
    color: var(--text-faint);
    margin-bottom: 24px;
    transition: color 0.2s ease;
  }

  .back:hover {
    color: var(--accent);
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin-top: 24px;
    color: var(--accent);
  }

  .sub {
    margin-top: 16px;
    font-size: 1.05rem;
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 40px;
  }

  .post-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }

  .post h2 {
    font-size: 1.2rem;
    transition: color 0.2s ease;
  }

  .post:hover h2 {
    color: var(--accent);
  }

  .post time {
    font-size: 0.78rem;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .post p {
    margin-top: 10px;
    font-size: 0.92rem;
  }
</style>
