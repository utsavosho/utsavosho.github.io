<section class="hero">
  <div class="container">
    <h1>
      <span class="accent">Data Engineer.</span>
    </h1>
    <p class="lede">
      4 years building data pipelines for major French retailers.
    </p>
    <div class="cta">
      <a href="/blog" class="btn btn-primary">Read the blog</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 140px;
    padding-bottom: 80px;
  }

  h1 {
    font-size: clamp(2.4rem, 5vw, 4rem);
    max-width: 16ch;
    margin-top: 24px;
  }

  .accent {
    color: var(--accent);
  }

  .lede {
    font-size: 1.15rem;
    max-width: 46ch;
    margin-top: 24px;
  }

  .cta {
    display: flex;
    gap: 14px;
    margin-top: 40px;
  }

  @media (max-width: 640px) {
    .cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
