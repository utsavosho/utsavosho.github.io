---
import CosmicScene from './CosmicScene.astro';
---

<CosmicScene />

<section class="hero">
  <div class="container hero-inner">
    <span class="eyebrow hero-anim" style="--d: 0">DATA ENGINEER · BUILDER · LIFELONG LEARNER</span>
    <h1>
      <span class="hero-anim" style="--d: 1">Building systems.</span>
      <span class="hero-anim" style="--d: 2">Exploring possibilities.</span>
    </h1>
    <p class="lede hero-anim" style="--d: 3">
      A Data Engineer fascinated by the systems, technologies, and ideas
      that turn raw data into something meaningful.
    </p>
    <div class="cta hero-anim" style="--d: 4">
      <a href="#blog" class="btn btn-primary">Enter my universe ↓</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: 160px;
    padding-bottom: 120px;
    min-height: 92vh;
    display: flex;
    align-items: center;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  h1 {
    display: flex;
    flex-direction: column;
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    max-width: 18ch;
    margin-top: 28px;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .lede {
    font-size: 1.2rem;
    max-width: 50ch;
    margin-top: 28px;
  }

  .cta {
    display: flex;
    gap: 14px;
    margin-top: 44px;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 120px;
      min-height: auto;
    }
  }

  /* Staggered entrance */
  .hero-anim {
    opacity: 0;
    transform: translateY(22px);
    animation: hero-fade-up 0.9s var(--ease) forwards;
    animation-delay: calc(var(--d, 0) * 0.16s + 0.1s);
  }

  @keyframes hero-fade-up {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-anim {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
