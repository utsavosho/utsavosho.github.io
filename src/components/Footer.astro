---
const year = new Date().getFullYear();
const links = [
  { href: 'https://github.com/utsavosho', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/utsavpandey/', label: 'LinkedIn' },
  { href: 'mailto:utsav.pandey18@gmail.com', label: 'Email' },
];
---

<footer>
  <div class="container inner">
    <div class="meta">
      <p class="mono">&copy; {year}</p>
      <p class="mono clock" id="footer-clock" aria-label="Current time in Paris">
        <span class="dot" aria-hidden="true"></span>
        Paris — <span id="footer-clock-time">--:--:--</span>
      </p>
    </div>
    <div class="links">
      {links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 32px 0;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  p {
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .clock {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .clock .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent-glow);
    flex: 0 0 auto;
  }

  .links {
    display: flex;
    gap: 20px;
  }

  .links a {
    font-size: 0.85rem;
    color: var(--text-dim);
    transition: color 0.2s ease;
  }

  .links a:hover {
    color: var(--accent);
  }
</style>

<script>
  const el = document.getElementById('footer-clock-time');
  if (el) {
    const formatter = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Europe/Paris',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
    });
    const tick = () => {
      el.textContent = formatter.format(new Date());
    };
    tick();
    setInterval(tick, 1000);
  }
</script>
