---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Blog — Utsav Pandey" description="Writing on data engineering, pipelines, and systems.">
  <section>
    <div class="container">
      <div class="head">
        <div>
          <span class="eyebrow">Writing</span>
          <h1>Blog</h1>
          <p class="sub">Notes on data engineering, pipelines, and the systems behind them.</p>
        </div>
        <a href="/tags" class="btn btn-ghost">Browse by tag</a>
      </div>

      <div class="posts">
        {posts.map((post) => (
          <div class="card post">
            <a href={`/blog/${post.id}`} class="post-link">
              <div class="post-head">
                <h2>{post.data.title}</h2>
                <time class="mono">
                  {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </div>
              <p>{post.data.description}</p>
            </a>
            <div class="tags">
              {post.data.tags.map((t) => <a href={`/tags/${t}`} class="tag">{t}</a>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin-top: 16px;
  }

  .sub {
    margin-top: 16px;
    font-size: 1.05rem;
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 40px;
  }

  .post-link {
    display: block;
  }

  .post-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }

  .post h2 {
    font-size: 1.2rem;
    transition: color 0.2s ease;
  }

  .post:hover h2 {
    color: var(--accent);
  }

  .post time {
    font-size: 0.78rem;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .post p {
    margin-top: 10px;
    font-size: 0.92rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .tags .tag {
    position: relative;
    z-index: 1;
    transition: border-color 0.2s ease;
  }

  .tags .tag:hover {
    border-color: var(--accent);
  }
</style>
