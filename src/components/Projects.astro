---
const projects = [
  {
    name: 'Multi-Retailer Ingestion Platform',
    description:
      'Large-scale ingestion pipelines pulling product catalogs from 20+ e-commerce sources, with proxy rotation and request management to keep feeds reliable across 8+ retail clients.',
    stack: ['Python', 'PySpark', 'Airflow'],
  },
  {
    name: 'PySpark Enrichment Engine',
    description:
      'Distributed preprocessing for high-volume product data: parsing semi-structured feeds, cleaning, normalization, deduplication, and multi-source joins.',
    stack: ['PySpark', 'Python'],
  },
  {
    name: 'Snowflake + dbt Warehouse',
    description:
      'Data warehouse architecture and dbt models serving multi-client analytical workloads — transformation, validation, and modeling for 8+ isolated production environments.',
    stack: ['Snowflake', 'dbt', 'SQL'],
  },
  {
    name: 'Marketplace Publishing Pipeline',
    description:
      'End-to-end delivery of enriched product data into Mirakl for automated listing generation and publication across retailer catalogs.',
    stack: ['Airflow', 'Python', 'Mirakl'],
  },
];
---

<section id="projects">
  <div class="container">
    <span class="eyebrow">Selected work</span>
    <h2>Projects</h2>
    <p class="sub">
      Systems built in production at Nricher, a SaaS platform for product data
      enrichment across major French retailers. Client work — no public repos.
    </p>

    <div class="grid">
      {projects.map((p) => (
        <div class="card project">
          <h3>{p.name}</h3>
          <p>{p.description}</p>
          <div class="stack">
            {p.stack.map((s) => <span class="tag">{s}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin-top: 16px;
  }

  .sub {
    max-width: 60ch;
    margin-top: 16px;
    font-size: 0.95rem;
    margin-bottom: 48px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .project {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .project h3 {
    font-size: 1.15rem;
  }

  .project p {
    font-size: 0.9rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 6px;
  }
</style>
