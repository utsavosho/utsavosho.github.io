---
---

<canvas id="cosmic-canvas" class="cosmic-canvas" aria-hidden="true"></canvas>

<style>
  .cosmic-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 50% at 70% 20%, rgba(91, 163, 255, 0.08), transparent 60%),
      radial-gradient(ellipse 60% 40% at 20% 70%, rgba(139, 123, 255, 0.07), transparent 60%),
      var(--bg);
  }
</style>

<script>
  import * as THREE from 'three';

  const canvas = document.getElementById('cosmic-canvas') as HTMLCanvasElement | null;
  if (canvas) initCosmicScene(canvas);

  function initCosmicScene(canvas: HTMLCanvasElement) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isNarrow = window.innerWidth < 700;

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: true, powerPreference: 'high-performance' });
    } catch {
      canvas.style.display = 'none';
      return;
    }

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 200);
    camera.position.set(0, 0, 9);

    // Positioning scene objects in fixed world units only looks right at the
    // aspect ratio it was tuned for — on a wider monitor the visible frustum
    // is much wider, so the same coordinates cluster near the center instead
    // of spanning the screen. Position things as a fraction of the actual
    // visible width/height at their depth instead, so the scene spreads
    // edge-to-edge on any screen size.
    function visibleHalfSizeAtZ(worldZ: number) {
      const distance = Math.abs(camera.position.z - worldZ);
      const vFov = THREE.MathUtils.degToRad(camera.fov);
      const halfHeight = Math.tan(vFov / 2) * distance;
      const halfWidth = halfHeight * camera.aspect;
      return { halfWidth, halfHeight };
    }

    const bgColor = new THREE.Color('#050609');
    renderer.setClearColor(bgColor, 1);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);

    // ---- Procedural soft-dot texture (used for stars and nebula, no image assets) ----
    function makeRadialTexture(inner: string, outer: string, size = 128) {
      const c = document.createElement('canvas');
      c.width = c.height = size;
      const g = c.getContext('2d')!;
      const grad = g.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
      grad.addColorStop(0, inner);
      grad.addColorStop(1, outer);
      g.fillStyle = grad;
      g.fillRect(0, 0, size, size);
      const tex = new THREE.CanvasTexture(c);
      tex.needsUpdate = true;
      return tex;
    }

    const starTexture = makeRadialTexture('rgba(255,255,255,1)', 'rgba(255,255,255,0)', 64);
    const nebulaTextureViolet = makeRadialTexture('rgba(139,123,255,0.5)', 'rgba(139,123,255,0)', 256);
    const nebulaTextureBlue = makeRadialTexture('rgba(91,163,255,0.4)', 'rgba(91,163,255,0)', 256);

    // ---- Starfield: three depth layers for genuine parallax ----
    type StarLayer = { points: THREE.Points; parallax: number; spin: number };
    const starLayers: StarLayer[] = [];

    function buildStarLayer(count: number, radiusRange: [number, number], size: number, parallax: number, spin: number) {
      const positions = new Float32Array(count * 3);
      for (let i = 0; i < count; i++) {
        const r = radiusRange[0] + Math.random() * (radiusRange[1] - radiusRange[0]);
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos(2 * Math.random() - 1);
        positions[i * 3] = r * Math.sin(phi) * Math.cos(theta);
        positions[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta);
        positions[i * 3 + 2] = r * Math.cos(phi);
      }
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      const mat = new THREE.PointsMaterial({
        size,
        map: starTexture,
        transparent: true,
        opacity: 0.9,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
        sizeAttenuation: true,
      });
      const points = new THREE.Points(geo, mat);
      scene.add(points);
      starLayers.push({ points, parallax, spin });
    }

    const starScale = isNarrow ? 0.5 : 1;
    buildStarLayer(Math.round(1800 * starScale), [60, 100], 0.6, 0.025, 0.0015);
    buildStarLayer(Math.round(900 * starScale), [35, 60], 0.9, 0.05, 0.003);
    buildStarLayer(Math.round(350 * starScale), [18, 34], 1.3, 0.09, 0.005);

    // ---- Nebula dust: soft procedurally-colored sprites at varying depth ----
    // Placed as a fraction of the visible width/height at their depth, so
    // they spread edge-to-edge on any screen size instead of clustering
    // near the center on wide monitors.
    function placeAt(xFrac: number, yFrac: number, z: number): [number, number, number] {
      const { halfWidth, halfHeight } = visibleHalfSizeAtZ(z);
      return [xFrac * halfWidth, yFrac * halfHeight, z];
    }

    const nebulaGroup = new THREE.Group();
    const nebulaConfigs: Array<[THREE.Texture, number, number, number, number]> = [
      [nebulaTextureViolet, ...placeAt(-0.85, 0.35, -30), 30],
      [nebulaTextureBlue, ...placeAt(0.95, -0.4, -40), 34],
      [nebulaTextureViolet, ...placeAt(0.5, 0.55, -50), 38],
      [nebulaTextureBlue, ...placeAt(-1.05, -0.45, -45), 32],
    ];
    nebulaConfigs.forEach(([tex, x, y, z, scale]) => {
      const mat = new THREE.SpriteMaterial({ map: tex, transparent: true, opacity: 0.5, depthWrite: false, blending: THREE.AdditiveBlending });
      const sprite = new THREE.Sprite(mat);
      sprite.position.set(x, y, z);
      sprite.scale.set(scale, scale, 1);
      nebulaGroup.add(sprite);
    });
    scene.add(nebulaGroup);

    // ---- Distant galaxies: procedural spiral-ish sprites, no image assets ----
    function makeGalaxyTexture(color: string, size = 256) {
      const c = document.createElement('canvas');
      c.width = c.height = size;
      const g = c.getContext('2d')!;
      const cx = size / 2;
      const cy = size / 2;
      g.translate(cx, cy);
      // Faint spiral arms: several rotated, elongated soft ellipses.
      for (let i = 0; i < 3; i++) {
        g.save();
        g.rotate((i * Math.PI * 2) / 3 + 0.4);
        const armGrad = g.createRadialGradient(0, 0, 0, 0, 0, size * 0.46);
        armGrad.addColorStop(0, color.replace('ALPHA', '0.28'));
        armGrad.addColorStop(1, color.replace('ALPHA', '0'));
        g.fillStyle = armGrad;
        g.scale(1, 0.32);
        g.beginPath();
        g.ellipse(size * 0.22, 0, size * 0.34, size * 0.34, 0, 0, Math.PI * 2);
        g.fill();
        g.restore();
      }
      g.rotate(0);
      // Bright core.
      const coreGrad = g.createRadialGradient(0, 0, 0, 0, 0, size * 0.16);
      coreGrad.addColorStop(0, color.replace('ALPHA', '0.95'));
      coreGrad.addColorStop(1, color.replace('ALPHA', '0'));
      g.fillStyle = coreGrad;
      g.beginPath();
      g.arc(0, 0, size * 0.16, 0, Math.PI * 2);
      g.fill();
      const tex = new THREE.CanvasTexture(c);
      tex.needsUpdate = true;
      return tex;
    }

    const galaxyTexViolet = makeGalaxyTexture('rgba(190,170,255,ALPHA)');
    const galaxyTexBlue = makeGalaxyTexture('rgba(150,200,255,ALPHA)');
    const galaxyGroup = new THREE.Group();
    const galaxyConfigs: Array<[THREE.Texture, number, number, number, number, number]> = [
      [galaxyTexViolet, ...placeAt(-0.92, 0.6, -42), 26, 0.6],
      [galaxyTexBlue, ...placeAt(1.0, 0.68, -55), 30, -0.9],
    ];
    galaxyConfigs.forEach(([tex, x, y, z, scale, rot]) => {
      const mat = new THREE.SpriteMaterial({ map: tex, transparent: true, opacity: 0.55, depthWrite: false, blending: THREE.AdditiveBlending, rotation: rot });
      const sprite = new THREE.Sprite(mat);
      sprite.position.set(x, y, z);
      sprite.scale.set(scale, scale, 1);
      galaxyGroup.add(sprite);
    });
    scene.add(galaxyGroup);

    // ---- Black hole: dark core + glowing accretion disc, far background ----
    const blackHoleGroup = new THREE.Group();
    blackHoleGroup.position.set(...placeAt(-0.82, 0.62, -22));
    scene.add(blackHoleGroup);

    const voidCore = new THREE.Mesh(
      new THREE.SphereGeometry(0.62, 32, 32),
      new THREE.MeshBasicMaterial({ color: 0x030308 })
    );
    blackHoleGroup.add(voidCore);

    const discInner = 0.72;
    const discOuter = 1.55;
    const accretionDisc = new THREE.Mesh(
      new THREE.RingGeometry(discInner, discOuter, 96),
      new THREE.ShaderMaterial({
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
        side: THREE.DoubleSide,
        uniforms: {
          innerR: { value: discInner / (2 * discOuter) },
          outerR: { value: 0.5 },
        },
        vertexShader: `
          varying vec2 vUv;
          void main() {
            vUv = uv;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          }
        `,
        fragmentShader: `
          uniform float innerR;
          uniform float outerR;
          varying vec2 vUv;
          void main() {
            float d = distance(vUv, vec2(0.5));
            float t = clamp((d - innerR) / (outerR - innerR), 0.0, 1.0);
            float fadeOuter = 1.0 - smoothstep(0.55, 1.0, t);
            float fadeInner = smoothstep(0.0, 0.18, t);
            float alpha = fadeOuter * fadeInner;
            vec3 hot = vec3(1.0, 0.85, 0.55);
            vec3 cool = vec3(0.55, 0.42, 1.0);
            vec3 color = mix(hot, cool, smoothstep(0.0, 1.0, t));
            gl_FragColor = vec4(color, alpha * 0.9);
          }
        `,
      })
    );
    accretionDisc.rotation.x = Math.PI / 2.4;
    blackHoleGroup.add(accretionDisc);

    // ---- Planets: small procedural solar system, no textures ----
    type Planet = { group: THREE.Group; mesh: THREE.Mesh; spin: number; radius: number };
    const planets: Planet[] = [];

    function createPlanet(opts: {
      radius: number;
      colorTop: string;
      colorBottom: string;
      glowColor: string;
      position: [number, number, number];
      spin: number;
      lightDir?: [number, number, number];
    }) {
      const group = new THREE.Group();
      group.position.set(...opts.position);
      scene.add(group);

      const geo = new THREE.SphereGeometry(opts.radius, 48, 48);
      const mat = new THREE.ShaderMaterial({
        uniforms: {
          colorTop: { value: new THREE.Color(opts.colorTop) },
          colorBottom: { value: new THREE.Color(opts.colorBottom) },
          lightDir: { value: new THREE.Vector3(...(opts.lightDir ?? [0.6, 0.5, 0.8])) },
        },
        vertexShader: `
          varying vec3 vNormal;
          varying vec3 vWorldPos;
          void main() {
            vNormal = normalize(normalMatrix * normal);
            vec4 worldPos = modelMatrix * vec4(position, 1.0);
            vWorldPos = worldPos.xyz;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          }
        `,
        fragmentShader: `
          uniform vec3 colorTop;
          uniform vec3 colorBottom;
          uniform vec3 lightDir;
          varying vec3 vNormal;
          varying vec3 vWorldPos;
          void main() {
            float grad = smoothstep(-1.5, 1.5, vWorldPos.y);
            vec3 base = mix(colorBottom, colorTop, grad);
            float diff = max(dot(normalize(vNormal), normalize(lightDir)), 0.0);
            vec3 lit = base * (0.4 + 0.7 * diff);
            vec3 viewDir = normalize(cameraPosition - vWorldPos);
            float fresnel = pow(1.0 - max(dot(normalize(vNormal), viewDir), 0.0), 2.2);
            vec3 rim = colorTop * fresnel * 0.8;
            gl_FragColor = vec4(lit + rim, 1.0);
          }
        `,
      });
      const mesh = new THREE.Mesh(geo, mat);
      group.add(mesh);

      const haloGeo = new THREE.SphereGeometry(opts.radius * 1.12, 32, 32);
      const haloMat = new THREE.ShaderMaterial({
        uniforms: { glowColor: { value: new THREE.Color(opts.glowColor) } },
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
        side: THREE.BackSide,
        vertexShader: `
          varying vec3 vNormal;
          varying vec3 vWorldPos;
          void main() {
            vNormal = normalize(normalMatrix * normal);
            vec4 worldPos = modelMatrix * vec4(position, 1.0);
            vWorldPos = worldPos.xyz;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          }
        `,
        fragmentShader: `
          uniform vec3 glowColor;
          varying vec3 vNormal;
          varying vec3 vWorldPos;
          void main() {
            vec3 viewDir = normalize(cameraPosition - vWorldPos);
            float fresnel = pow(1.0 - max(dot(normalize(vNormal), viewDir), 0.0), 3.0);
            gl_FragColor = vec4(glowColor, fresnel * 0.55);
          }
        `,
      });
      const halo = new THREE.Mesh(haloGeo, haloMat);
      group.add(halo);

      planets.push({ group, mesh, spin: opts.spin, radius: opts.radius });
      return { group, mesh };
    }

    // Main "hero" planet — violet, largest, foreground, interactive focal point.
    const { group: planetGroup, mesh: planet } = createPlanet({
      radius: 1.9,
      colorTop: '#9d8bff',
      colorBottom: '#1a1440',
      glowColor: '#8b7bff',
      position: placeAt(isNarrow ? 0.82 : 0.72, isNarrow ? 0.35 : 0.1, isNarrow ? -4 : -5.5),
      spin: 0.08,
    });
    planetGroup.scale.setScalar(isNarrow ? 0.58 : 1.1);

    // Smaller companion worlds, scattered at varying depth for a loose solar-system feel.
    createPlanet({
      radius: 1.4,
      colorTop: '#ffb27a',
      colorBottom: '#5c2a14',
      glowColor: '#ff9d5c',
      position: placeAt(isNarrow ? -0.78 : -0.86, -0.72, -9),
      spin: 0.14,
    });
    createPlanet({
      radius: 0.95,
      colorTop: '#6fe3d9',
      colorBottom: '#0f3a38',
      glowColor: '#4dffc4',
      position: placeAt(isNarrow ? 0.65 : 0.9, -0.48, -13),
      spin: 0.2,
    });
    if (!isNarrow) {
      createPlanet({
        radius: 0.75,
        colorTop: '#ff8fae',
        colorBottom: '#4a1226',
        glowColor: '#ff6f93',
        position: placeAt(-0.4, 0.8, -17),
        spin: 0.26,
      });
    }

    // Soft single light for the station/ship below (planets use their own baked shading).
    const keyLight = new THREE.DirectionalLight(0xffffff, 1.4);
    keyLight.position.set(4, 6, 8);
    scene.add(keyLight);
    scene.add(new THREE.AmbientLight(0x404060, 0.6));

    // ---- Space station: a small rotating-ring habitat, built from primitives ----
    const stationGroup = new THREE.Group();
    stationGroup.position.set(...placeAt(isNarrow ? 0.45 : 0.4, -0.75, -8));
    stationGroup.scale.setScalar(isNarrow ? 1.1 : 1.6);
    scene.add(stationGroup);

    const hullMat = new THREE.MeshStandardMaterial({ color: 0x8890a6, metalness: 0.6, roughness: 0.4 });
    const accentMat = new THREE.MeshStandardMaterial({ color: 0x3a3f55, metalness: 0.5, roughness: 0.5 });

    const stationHub = new THREE.Mesh(new THREE.SphereGeometry(0.11, 20, 20), hullMat);
    stationGroup.add(stationHub);

    const stationRing = new THREE.Mesh(new THREE.TorusGeometry(0.32, 0.022, 10, 48), accentMat);
    stationGroup.add(stationRing);

    for (let i = 0; i < 4; i++) {
      const spoke = new THREE.Mesh(new THREE.CylinderGeometry(0.008, 0.008, 0.32, 6), hullMat);
      spoke.rotation.z = Math.PI / 2;
      spoke.rotation.y = (i * Math.PI) / 2;
      stationGroup.add(spoke);
    }

    const windowTex = makeRadialTexture('rgba(255,224,170,1)', 'rgba(255,224,170,0)', 32);
    for (let i = 0; i < 6; i++) {
      const windowMat = new THREE.SpriteMaterial({ map: windowTex, transparent: true, depthWrite: false, blending: THREE.AdditiveBlending });
      const w = new THREE.Sprite(windowMat);
      const a = (i / 6) * Math.PI * 2;
      w.position.set(Math.cos(a) * 0.32, Math.sin(a) * 0.32, 0);
      w.scale.set(0.035, 0.035, 1);
      stationGroup.add(w);
    }

    // ---- Spaceship: a simple hull that drifts slowly across the scene ----
    const shipGroup = new THREE.Group();
    shipGroup.scale.setScalar(3.4);
    scene.add(shipGroup);

    const shipBody = new THREE.Mesh(new THREE.ConeGeometry(0.045, 0.22, 10), hullMat);
    shipBody.rotation.z = -Math.PI / 2;
    shipGroup.add(shipBody);

    const shipFin = new THREE.Mesh(new THREE.BoxGeometry(0.02, 0.1, 0.01), accentMat);
    shipFin.position.set(-0.05, 0, 0);
    shipGroup.add(shipFin);

    const engineGlowTex = makeRadialTexture('rgba(190,170,255,0.9)', 'rgba(190,170,255,0)', 64);
    const engineGlow = new THREE.Sprite(
      new THREE.SpriteMaterial({ map: engineGlowTex, transparent: true, depthWrite: false, blending: THREE.AdditiveBlending })
    );
    engineGlow.position.set(-0.13, 0, 0);
    engineGlow.scale.set(0.12, 0.12, 1);
    shipGroup.add(engineGlow);

    const shipZ = -2;
    const shipPath = {
      y: isNarrow ? -1.2 : -1.6,
      z: shipZ,
      span: visibleHalfSizeAtZ(shipZ).halfWidth * 1.15,
      speed: 0.045,
    };

    // ---- Click ripple on the planet ----
    type Ripple = { mesh: THREE.Mesh; start: number };
    const ripples: Ripple[] = [];
    const raycaster = new THREE.Raycaster();
    const pointerNdc = new THREE.Vector2();

    function spawnRipple(point: THREE.Vector3, hitPlanet: Planet) {
      const r = hitPlanet.radius;
      const geo = new THREE.RingGeometry(r * 0.11, r * 0.16, 48);
      const mat = new THREE.MeshBasicMaterial({
        color: 0xcfc7ff,
        transparent: true,
        opacity: 1,
        side: THREE.DoubleSide,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
        depthTest: false,
      });
      const mesh = new THREE.Mesh(geo, mat);
      // Nudge slightly off the sphere surface along its normal to avoid z-fighting.
      const normal = point.clone().sub(hitPlanet.group.position).normalize();
      mesh.position.copy(point).addScaledVector(normal, r * 0.02);
      mesh.lookAt(camera.position);
      mesh.renderOrder = 10;
      scene.add(mesh);
      ripples.push({ mesh, start: performance.now() });
    }

    const planetMeshes = () => planets.map((p) => p.mesh);

    function handlePointerDown(e: PointerEvent) {
      const target = e.target as HTMLElement | null;
      if (target && target.closest('a, button, input, textarea, [role="button"]')) return;
      pointerNdc.x = (e.clientX / window.innerWidth) * 2 - 1;
      pointerNdc.y = -(e.clientY / window.innerHeight) * 2 + 1;
      raycaster.setFromCamera(pointerNdc, camera);
      const hit = raycaster.intersectObjects(planetMeshes(), false)[0];
      if (!hit) return;
      const hitPlanet = planets.find((p) => p.mesh === hit.object);
      if (hitPlanet) spawnRipple(hit.point, hitPlanet);
    }

    // ---- Pointer parallax (mouse + touch) ----
    let pointerX = 0;
    let pointerY = 0;
    let targetPointerX = 0;
    let targetPointerY = 0;

    function handlePointerMove(e: PointerEvent) {
      targetPointerX = (e.clientX / window.innerWidth) * 2 - 1;
      targetPointerY = (e.clientY / window.innerHeight) * 2 - 1;
    }

    // ---- Scroll-driven fade + pause for performance ----
    let running = true;
    let heroHeight = window.innerHeight;

    function updateHeroHeight() {
      const hero = document.querySelector('.hero');
      heroHeight = hero ? (hero as HTMLElement).offsetHeight : window.innerHeight;
    }

    function handleScroll() {
      const ratio = Math.min(Math.max(window.scrollY / heroHeight, 0), 1);
      canvas.style.opacity = String(1 - ratio);
      const shouldRun = ratio < 0.98;
      if (shouldRun && !running) {
        running = true;
        timer.update();
        animate();
      }
      running = shouldRun;
    }

    // ---- Resize ----
    let resizeTimer: ReturnType<typeof setTimeout>;
    function handleResize() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
        updateHeroHeight();
        if (prefersReducedMotion) renderStaticFrame();
      }, 150);
    }

    const timer = new THREE.Timer();

    function renderStaticFrame() {
      renderer.render(scene, camera);
    }

    function animate() {
      if (!running) return;
      timer.update();
      const delta = Math.min(timer.getDelta(), 0.05);
      const elapsed = timer.getElapsed();

      pointerX += (targetPointerX - pointerX) * 0.04;
      pointerY += (targetPointerY - pointerY) * 0.04;

      camera.position.x += (pointerX * 0.6 - camera.position.x) * 0.03;
      camera.position.y += (-pointerY * 0.4 - camera.position.y) * 0.03;
      camera.lookAt(0, 0, 0);

      starLayers.forEach((layer) => {
        layer.points.rotation.y += layer.spin;
        layer.points.rotation.x = pointerY * layer.parallax;
        layer.points.rotation.y += pointerX * layer.parallax * 0.02;
      });

      planets.forEach((p) => {
        p.mesh.rotation.y += delta * p.spin;
      });
      nebulaGroup.children.forEach((child, i) => {
        child.position.y += Math.sin(elapsed * 0.1 + i) * 0.0015;
      });

      stationGroup.rotation.y += delta * 0.12;
      stationRing.rotation.z += delta * 0.25;

      accretionDisc.rotation.z += delta * 0.06;

      const shipT = (elapsed * shipPath.speed) % 1;
      shipGroup.position.set(-shipPath.span + shipT * shipPath.span * 2, shipPath.y + Math.sin(elapsed * 0.3) * 0.15, shipPath.z);
      shipGroup.visible = shipT < 0.96;

      for (let i = ripples.length - 1; i >= 0; i--) {
        const r = ripples[i];
        const t = (performance.now() - r.start) / 900;
        if (t >= 1) {
          scene.remove(r.mesh);
          r.mesh.geometry.dispose();
          (r.mesh.material as THREE.Material).dispose();
          ripples.splice(i, 1);
          continue;
        }
        const scale = 1 + t * 4.5;
        r.mesh.scale.setScalar(scale);
        (r.mesh.material as THREE.MeshBasicMaterial).opacity = 0.9 * (1 - t);
      }

      renderer.render(scene, camera);
      if (running) requestAnimationFrame(animate);
    }

    updateHeroHeight();

    if (prefersReducedMotion) {
      renderStaticFrame();
    } else {
      window.addEventListener('pointermove', handlePointerMove, { passive: true });
      window.addEventListener('pointerdown', handlePointerDown, { passive: true });
      window.addEventListener('scroll', handleScroll, { passive: true });
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible' && window.scrollY < heroHeight) {
          if (!running) {
            running = true;
            timer.update();
            animate();
          }
        } else {
          running = false;
        }
      });
      animate();
    }

    window.addEventListener('resize', handleResize, { passive: true });
  }
</script>
