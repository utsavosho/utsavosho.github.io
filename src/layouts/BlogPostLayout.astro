---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
}

const { title, description, pubDate, updatedDate, tags } = Astro.props;

const formatted = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — Blog`} description={description}>
  <article>
    <div class="container narrow">
      <a href="/blog" class="back mono">&larr; Back to blog</a>
      <h1>{title}</h1>
      <div class="meta">
        <time class="mono">{formatted}</time>
        {updatedDate && <span class="mono">Updated {updatedDate.toLocaleDateString('en-US')}</span>}
      </div>
      <div class="tags">
        {tags.map((t) => <a href={`/tags/${t}`} class="tag">{t}</a>)}
      </div>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  article {
    padding: 64px 0 96px;
  }

  .narrow {
    max-width: 720px;
  }

  .back {
    font-size: 0.82rem;
    color: var(--text-faint);
    transition: color 0.2s ease;
  }

  .back:hover {
    color: var(--accent);
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-top: 20px;
  }

  .meta {
    display: flex;
    gap: 16px;
    margin-top: 16px;
    font-size: 0.82rem;
    color: var(--text-faint);
  }

  .tags {
    display: flex;
    gap: 6px;
    margin-top: 16px;
  }

  .tags .tag {
    transition: border-color 0.2s ease;
  }

  .tags .tag:hover {
    border-color: var(--accent);
  }

  .prose {
    margin-top: 40px;
    font-size: 1.02rem;
    line-height: 1.75;
    color: var(--text);
  }

  .prose :global(p) {
    color: var(--text);
    margin-bottom: 1.4em;
  }

  .prose :global(h2) {
    font-size: 1.4rem;
    margin-top: 2em;
    margin-bottom: 0.6em;
  }

  .prose :global(h3) {
    font-size: 1.15rem;
    margin-top: 1.6em;
    margin-bottom: 0.5em;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(code) {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.88em;
  }

  .prose :global(pre) {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    overflow-x: auto;
  }

  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 18px;
    color: var(--text-dim);
    margin: 1.4em 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
    margin-bottom: 1.4em;
  }

  .prose :global(li) {
    margin-bottom: 0.5em;
  }

  .prose :global(img) {
    max-width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
</style>
