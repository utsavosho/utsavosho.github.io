---
---

<canvas id="dataflow-canvas" class="dataflow-canvas" aria-hidden="true"></canvas>

<style>
  .dataflow-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  const canvas = document.getElementById('dataflow-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    if (ctx) initDataFlow(canvas, ctx);
  }

  function initDataFlow(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const LIME = '198, 255, 61';
    const MINT = '77, 255, 196';

    let width = 0;
    let height = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);

    type Node = { x: number; y: number; baseX: number; baseY: number; r: number; hue: number };
    type Edge = { a: number; b: number; particles: number[] };

    let nodes: Node[] = [];
    let edges: Edge[] = [];
    let mouse = { x: -9999, y: -9999, active: false };
    let rafId = 0;
    let visible = true;

    function nodeCount() {
      if (width < 560) return 9;
      if (width < 900) return 13;
      return 18;
    }

    function buildGraph() {
      const count = nodeCount();
      nodes = Array.from({ length: count }, () => {
        const x = Math.random() * width;
        const y = Math.random() * height;
        return { x, y, baseX: x, baseY: y, r: 1.6 + Math.random() * 1.8, hue: Math.random() > 0.78 ? MINT : LIME };
      });

      edges = [];
      // Connect each node to its 2 nearest neighbors, forming an organic mesh.
      nodes.forEach((n, i) => {
        const distances = nodes
          .map((other, j) => ({ j, d: i === j ? Infinity : Math.hypot(n.x - other.x, n.y - other.y) }))
          .sort((a, b) => a.d - b.d);
        const neighbors = distances.slice(0, 2);
        for (const { j } of neighbors) {
          if (!edges.some((e) => (e.a === i && e.b === j) || (e.a === j && e.b === i))) {
            const particleCount = 1 + Math.floor(Math.random() * 2);
            edges.push({ a: i, b: j, particles: Array.from({ length: particleCount }, () => Math.random()) });
          }
        }
      });
    }

    function resize() {
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      buildGraph();
    }

    function drawStatic() {
      ctx.clearRect(0, 0, width, height);
      drawEdges(1);
      drawNodes();
    }

    function drawEdges(particleProgress: number | null) {
      edges.forEach((edge) => {
        const a = nodes[edge.a];
        const b = nodes[edge.b];
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.strokeStyle = `rgba(${LIME}, 0.08)`;
        ctx.lineWidth = 1;
        ctx.stroke();

        if (particleProgress !== null) {
          edge.particles.forEach((t) => {
            const px = a.x + (b.x - a.x) * t;
            const py = a.y + (b.y - a.y) * t;
            ctx.beginPath();
            ctx.arc(px, py, 1.7, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(${a.hue}, 0.85)`;
            ctx.fill();
          });
        }
      });
    }

    function drawNodes() {
      nodes.forEach((n) => {
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${n.hue}, 0.9)`;
        ctx.fill();

        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r + 4, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${n.hue}, 0.08)`;
        ctx.fill();
      });
    }

    function step() {
      if (!visible) return;
      ctx.clearRect(0, 0, width, height);

      // Gentle cursor-reactive drift: nodes ease toward/away from the pointer.
      nodes.forEach((n) => {
        let targetX = n.baseX;
        let targetY = n.baseY;
        if (mouse.active) {
          const dx = n.baseX - mouse.x;
          const dy = n.baseY - mouse.y;
          const dist = Math.hypot(dx, dy);
          const radius = 180;
          if (dist < radius) {
            const force = (1 - dist / radius) * 18;
            targetX = n.baseX + (dx / (dist || 1)) * force;
            targetY = n.baseY + (dy / (dist || 1)) * force;
          }
        }
        n.x += (targetX - n.x) * 0.06;
        n.y += (targetY - n.y) * 0.06;
      });

      drawEdges(0);
      drawNodes();

      edges.forEach((edge) => {
        const a = nodes[edge.a];
        const b = nodes[edge.b];
        edge.particles.forEach((t, i) => {
          let nt = t + 0.0028;
          if (nt > 1) nt = 0;
          edge.particles[i] = nt;
          const px = a.x + (b.x - a.x) * nt;
          const py = a.y + (b.y - a.y) * nt;
          ctx.beginPath();
          ctx.arc(px, py, 1.8, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${a.hue}, 0.9)`;
          ctx.shadowColor = `rgba(${a.hue}, 0.8)`;
          ctx.shadowBlur = 6;
          ctx.fill();
          ctx.shadowBlur = 0;
        });
      });

      rafId = requestAnimationFrame(step);
    }

    resize();

    if (prefersReducedMotion) {
      drawStatic();
    } else {
      rafId = requestAnimationFrame(step);

      window.addEventListener(
        'pointermove',
        (e) => {
          const rect = canvas.getBoundingClientRect();
          mouse.x = e.clientX - rect.left;
          mouse.y = e.clientY - rect.top;
          mouse.active = true;
        },
        { passive: true }
      );

      window.addEventListener(
        'pointerleave',
        () => {
          mouse.active = false;
        },
        { passive: true }
      );

      document.addEventListener('visibilitychange', () => {
        visible = document.visibilityState === 'visible';
        if (visible && !rafId) rafId = requestAnimationFrame(step);
      });
    }

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener(
      'resize',
      () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          resize();
          if (prefersReducedMotion) drawStatic();
        }, 150);
      },
      { passive: true }
    );
  }
</script>
