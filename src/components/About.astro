---
const stack = ['Python', 'Snowflake', 'dbt', 'Airflow', 'Azure', 'SQL'];
---

<section id="about">
  <div class="container">
    <span class="eyebrow reveal">About</span>
    <p class="bio reveal">
      I'm a Data Engineer based in Paris, building large-scale ingestion and
      transformation pipelines for major French retail platforms. This site
      is where I write about what I'm learning along the way — the tools,
      the failures, and the systems behind modern data platforms.
    </p>
    <div class="stack reveal">
      {stack.map((item) => <span class="tag">{item}</span>)}
    </div>
  </div>
</section>

<style>
  .bio {
    margin-top: 20px;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text);
    max-width: 62ch;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }
</style>
