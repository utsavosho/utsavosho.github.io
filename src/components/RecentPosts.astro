---
import { getCollection } from 'astro:content';
import { getReadingTime } from '../utils/readingTime';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section id="writing">
  <div class="container">
    <div class="head reveal">
      <div>
        <span class="eyebrow">Recent writing</span>
        <h2>Notes from the field</h2>
      </div>
      <a href="/blog" class="btn btn-ghost">View all posts</a>
    </div>

    {posts.length === 0 ? (
      <p class="empty reveal">First post is on its way.</p>
    ) : (
      <div class="grid">
        {posts.map((post) => {
          const minutes = getReadingTime(post.id);
          const topic = post.data.tags[0] ?? 'Notes';
          return (
            <a href={`/blog/${post.id}`} class="card post-card reveal">
              <span class="topic mono">{topic}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="meta mono">
                <time>
                  {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
                <span aria-hidden="true">·</span>
                <span>{minutes} min read</span>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }

  h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin-top: 16px;
  }

  .empty {
    margin-top: 40px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 48px;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    overflow: hidden;
  }

  .post-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--accent-glow), transparent 55%);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
    pointer-events: none;
  }

  .post-card:hover::before {
    opacity: 1;
  }

  .post-card:hover {
    border-color: var(--accent);
  }

  .topic {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .post-card h3 {
    font-size: 1.15rem;
    transition: color 0.2s ease;
  }

  .post-card p {
    font-size: 0.9rem;
    flex: 1;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    color: var(--text-faint);
    margin-top: auto;
    padding-top: 4px;
  }
</style>
